{
  "name": "workspace-api",
  "version": "1.0.0",
  "description": "REST API for Personal Workspace",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "prisma:generate": "prisma generate --schema=src/modules/job-tracker/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/modules/job-tracker/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=src/modules/job-tracker/prisma/schema.prisma",
    "prisma:seed": "ts-node src/modules/job-tracker/prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node src/modules/job-tracker/prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
