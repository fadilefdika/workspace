datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_CONTENT_PLANNER")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../../../../../node_modules/@prisma/client-content-planner"
}

model ContentItem {
  id              String         @id @default(cuid())
  title           String
  description     String?
  contentBody     String?
  status          ContentStatus  @default(IDEA)
  platform        Platform
  targetDate      DateTime?      @map("target_date")
  publishUrl      String?        @map("publish_url")
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("content_items")
}

enum ContentStatus {
  IDEA
  DRAFTING
  REVIEW
  SCHEDULED
  PUBLISHED
}

enum Platform {
  LINKEDIN
  THREADS
}
